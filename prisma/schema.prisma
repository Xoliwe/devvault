generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())

  files     File[]
  folders   Folder[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])

  files     File[]
}

model File {
  id          String   @id @default(cuid())
  name        String
  size        Int
  mimeType    String
  storagePath String
  createdAt   DateTime @default(now())

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])

  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id])
}